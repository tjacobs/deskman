# Install with:
#   sudo cp teleport/start_teleport.sh /usr/local/bin/start_teleport.sh
#   sudo chmod 755 /usr/local/bin/start_teleport.sh
#   sudo cp teleport/teleport.service /etc/systemd/system/teleport.service
#   sudo systemctl daemon-reload && sudo systemctl enable teleport.service
#
# The start_teleport.sh script exists to run the binary as the user who owns it.
# Programs connect to $XDG_RUNTIME_DIR/teleport.interface.

[Unit]
Description=Teleport
After=display-manager.service

[Install]
WantedBy=graphical.target

[Service]
Type=simple
ExecStart=/usr/local/bin/start_teleport.sh
Restart=on-failure
RestartSec=5
TimeoutStartSec=60
KillMode=mixed
